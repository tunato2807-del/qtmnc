digraph G {graph [fontname="DejaVu Sans",bgcolor="white",pad="0.3",nodesep="0.4",ranksep="0.55"];
node [fontname="DejaVu Sans",shape=box,style="rounded,filled",fillcolor="#eef4ff",color="#6a89c4",fontsize=14,margin="0.20,0.14"];
edge [fontname="DejaVu Sans",fontsize=11,color="#69829b",arrowsize=0.7];
rankdir=TB;
start[label="Lấy mẫu theo lịch",fillcolor="#dff5ee"];
read[label="Dùng lại SSH / đọc một batch
Hai mẫu CPU cách nhau ~1 giây"];
check[label="Có kết nối / dữ liệu hợp lệ?",shape=diamond,fillcolor="#fff1da"];
engine[label="Đánh giá từng metric
Giữ last_known khi UNKNOWN"];
missing[label="Không có mẫu mới
DOWN hoặc UNKNOWN
Không tạo số 0 giả",fillcolor="#ffe9e9",color="#c16b75"];
tx[label="Một transaction SQLite
State + sample + event + outbox",shape=cylinder,fillcolor="#f0eaff"];
ui[label="Dashboard đọc dữ liệu đã commit
Biểu đồ / tuổi mẫu / CSV",fillcolor="#dff5ee"];
send[label="Luồng gửi lấy tin đầu hàng đợi"];
ack[label="API xác nhận?",shape=diamond,fillcolor="#fff1da"];
retry[label="Giữ outbox · tăng attempts
Backoff / Retry-After",fillcolor="#ffe9e9"];
done[label="Xóa tin đã giao
Tiếp tục vòng đo",fillcolor="#dff5ee"];
start -> read -> check;check -> engine[label="Có"];check -> missing[label="Lỗi"];engine -> tx;missing -> tx;tx -> ui;tx -> send -> ack;ack -> retry[label="Chưa"];retry -> send[label="Đến hạn"];ack -> done[label="Có"];
}