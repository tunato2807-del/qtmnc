digraph G {
 graph [rankdir=TB,bgcolor="white",pad=".25",nodesep=".32",ranksep=".45",fontname="Noto Sans",compound=true];
 node [shape=box,style="rounded,filled",fillcolor="#eaf2ff",color="#2563eb",fontname="Noto Sans",fontsize=13,margin=".16,.1"];
 edge [fontname="Noto Sans",fontsize=11,color="#64748b",fontcolor="#334155"];
 windows [label="WINDOWS HOST\nVS Code + Python — SSH/SNMP\nVMnet1: 192.168.10.1/24"];
 internet [label="Internet → Telegram / Slack\nHTTPS từ Windows",fillcolor="#f1f5f9",color="#64748b"];
 subgraph cluster_gns_management {
  label="GNS3 LOCAL — ĐƯỜNG QUẢN TRỊ"; style="rounded"; color="#ea580c"; fontname="Noto Sans";
  c1 [label="Cloud\nWINDOWS-VMNET1"];
  sw1 [label="SW-MANAGEMENT\nVLAN 1"];
  c2 [label="Cloud\nLINUX-MGMT-VMNET2"];
  {rank=same;c1;sw1;c2}
  c1 -> sw1 -> c2 [dir=none];
 }
 subgraph cluster_linux {
  label="MỘT UBUNTU VM TRONG VMWARE"; style=rounded; color="#059669"; fontname="Noto Sans";
  mgmt [label="NIC2: Custom VMnet2\ngns3mgmt: 192.168.10.129/24\nQuản trị SSH/SNMP",fillcolor="#ecfdf5",color="#059669"];
  data [label="NIC3: Custom VMnet3\ngns3test: 192.168.30.129/24\nInterface được thử DOWN",fillcolor="#ecfdf5",color="#059669"];
  nat [label="NIC1: NAT / VMnet8\nens33: 192.168.73.129/24\ngateway 192.168.73.2",fillcolor="#f1f5f9",color="#64748b"];
  {rank=same;mgmt;data;nat}
  mgmt -> data [dir=none,label="Cùng thiết bị"];
  data -> nat [style=invis];
 }
 subgraph cluster_gns_test {
  label="GNS3 LOCAL — MẠNG THỬ NGHIỆM"; style=rounded; color="#ea580c"; fontname="Noto Sans";
  c3 [label="Cloud\nLINUX-DATA-VMNET3"];
  sw2 [label="SW-TEST\nVLAN 1"];
  vpcs [label="VPCS-TEST\n192.168.30.10/24"];
  {rank=same;c3;sw2;vpcs}
  c3 -> sw2 -> vpcs [dir=none];
 }
 note [label="Windows VMnet2 = 192.168.20.1/24; NIC2 Linux dùng .10 qua cầu GNS3.\nHai NIC lab không đặt gateway; NAT giữ Internet và đường cứu hộ.\nTháo dây Cloud có thể không làm VMware operstate DOWN.",fillcolor="#fffbeb",color="#d97706"];
 windows -> c1 [label="Qua VMnet1",dir=both];
 c2 -> mgmt [label="Qua VMnet2",dir=both];
 data -> c3 [label="Qua VMnet3",dir=none];
 windows -> internet [label="Gửi cảnh báo"];
 nat -> internet [style=dashed,constraint=false];
 c3 -> note [style=invis];
}