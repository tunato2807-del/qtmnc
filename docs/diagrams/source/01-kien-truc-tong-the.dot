digraph G {
 graph [rankdir=TB, bgcolor="white", pad=".25", nodesep=".35", ranksep=".5", fontname="Noto Sans", compound=true];
 node [shape=box, style="rounded,filled", fillcolor="#eaf2ff", color="#2563eb", fontname="Noto Sans", fontsize=13, margin=".18,.12"];
 edge [color="#64748b", fontcolor="#334155", fontname="Noto Sans", fontsize=11];
 admin [label="Người quản trị",fillcolor="#f1f5f9",color="#64748b"];
 subgraph cluster_windows {
  label="WINDOWS HOST — VS CODE / PYTHON"; color="#94a3b8"; style=rounded; fontname="Noto Sans";
  env [label=".env.gns3 + known_hosts\nCấu hình local và xác minh SSH"];
  core [label="device_monitor\nLập lịch 5s + máy trạng thái"];
  collectors [label="SSH / SNMP / HYBRID\nNguồn ưu tiên + dự phòng"];
  ui [label="Dashboard Terminal\nChỉ số • nguồn • ngưỡng • trạng thái"];
  db [label="SQLite\nstates + outbox",shape=cylinder,fillcolor="#ecfdf5",color="#059669"];
  sender [label="Luồng gửi riêng\nRetry và xác nhận API"];
  env -> core; core -> collectors; core -> ui; core -> db; db -> sender;
 }
 gns [label="GNS3 LOCAL SERVER WINDOWS\nCloud VMnet1 ↔ SW-MANAGEMENT ↔ Cloud VMnet2",fillcolor="#fff7ed",color="#ea580c"];
 linux [label="UBUNTU VM — 192.168.10.129\nOpenSSH + Net-SNMP extend\nCPU / RAM / nhiệt độ + IF-MIB"];
 temperature [label="Nhiệt độ: auto → cảm biến thật / UNKNOWN\nHoặc demo luôn có nhãn MÔ PHỎNG",fillcolor="#fffbeb",color="#d97706"];
 tg [label="Telegram Bot API\nHTTPS 443"];
 slack [label="Slack Incoming Webhook\nHTTPS 443"];
 receiver [label="Ứng dụng nhắn tin\nCảnh báo và phục hồi",fillcolor="#ecfdf5",color="#059669"];
 admin -> env;
 collectors -> gns [label="SSH TCP 22 / SNMP UDP 161",dir=both];
 gns -> linux [dir=both]; linux -> temperature [style=dashed,dir=none];
 sender -> tg; sender -> slack;
 tg -> receiver; slack -> receiver;
 {rank=same;tg;slack}
}