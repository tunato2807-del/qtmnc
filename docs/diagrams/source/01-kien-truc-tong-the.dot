digraph G {
 graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.38", ranksep="0.55", fontname="Noto Sans", fontsize=16, compound=true];
 node [shape=box, style="rounded,filled", fillcolor="#eaf2ff", color="#2563eb", fontname="Noto Sans", fontsize=13, margin="0.18,0.12", penwidth=1.3];
 edge [color="#64748b", fontcolor="#334155", fontname="Noto Sans", fontsize=11, arrowsize=.75];
 admin [label="Người quản trị", fillcolor="#f1f5f9", color="#64748b"];
 linux [label="LINUX VM\n192.168.73.129\nOpenSSH Server"];
