digraph G {
 graph [rankdir=TB,bgcolor="white",pad=".2",nodesep=".35",ranksep=".4",fontname="Noto Sans",fontsize=16];
 node [shape=box,style="rounded,filled",fillcolor="#eaf2ff",color="#2563eb",fontname="Noto Sans",fontsize=13,margin=".18,.1",penwidth=1.3];
 edge [fontname="Noto Sans",fontsize=11,color="#64748b",fontcolor="#334155",arrowsize=.7];
 start [shape=oval,label="Bắt đầu chu kỳ"];
 read [label="SSH đọc CPU / RAM / interface\nNhiệt độ chỉ khi đã bật"];
 connected [shape=diamond,label="Đường SSH\nhoạt động?",fillcolor="#fffbeb",color="#d97706"];
 parse [label="Chuẩn hóa dữ liệu\nLỗi riêng chỉ số → UNKNOWN"];
 down [label="Kết nối → DOWN\nKhông suy diễn chỉ số thành 0",fillcolor="#fffbeb",color="#d97706"];
 evaluate [label="So sánh trạng thái đã lưu\nNgưỡng + hysteresis + mất dữ liệu"];
 change [shape=diamond,label="Có chuyển trạng thái\ncần thông báo?",fillcolor="#fffbeb",color="#d97706"];
 tx [label="Một giao dịch SQLite:\nTrạng thái + outbox từng kênh",fillcolor="#ecfdf5",color="#059669"];
 state [label="Chỉ lưu trạng thái\nKhông tạo tin lặp",fillcolor="#ecfdf5",color="#059669"];
 ui [label="Cập nhật dashboard\nMất SSH: đánh dấu số đo cũ"];
 wait [label="Chờ mốc chu kỳ tiếp theo (30s)\nBỏ qua mốc quá trễ"];
 start -> read -> connected;
 connected -> parse [label="Có"]; connected -> down [label="Không"];
 parse -> evaluate; down -> evaluate;
 evaluate -> change;
 change -> tx [label="Có"]; change -> state [label="Không"];
 tx -> ui; state -> ui;
 ui -> wait;
 wait -> read [constraint=false];
}
