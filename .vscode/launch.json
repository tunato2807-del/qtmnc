{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Windows -> Linux: monitor",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/monitor_ssh.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "args": ["--env-file", "${workspaceFolder}/.env"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
