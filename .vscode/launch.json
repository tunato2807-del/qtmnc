{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GNS3 -> Linux: SSH / SNMP monitor",
      "type": "debugpy",
      "request": "launch",
      "module": "device_monitor",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "args": ["--env-file", "${workspaceFolder}/.env.gns3"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
