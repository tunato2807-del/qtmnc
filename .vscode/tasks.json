{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Windows: setup",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "setup_windows.cmd"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Windows: check once",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "run_windows.cmd", "--once"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
