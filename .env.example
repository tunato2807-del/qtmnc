# Sao chép thành .env.netwatch. Không đưa file đã có secret lên Git.
R1_SSH_USER=monitor
R1_SSH_PASSWORD=
SRV1_SSH_USER=monitor
SRV1_SSH_PASSWORD=
# Chỉ nhập kênh bạn sử dụng; để trống cả hai để xem dashboard cục bộ.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK=
# Tùy chọn SNMPv2c trong mạng lab; không dùng community công khai.
R1_SNMP_COMMUNITY=
SRV1_SNMP_COMMUNITY=
