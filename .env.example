# Copy to .env and fill in values. Never commit real credentials.
# Load on Bash: set -a; . ./.env; set +a
MONITOR_PROTOCOL=ssh
# OS of the device being monitored, not the OS running this script.
MONITOR_OS=linux
MONITOR_HOST=
MONITOR_INTERVAL=30
MONITOR_TIMEOUT=10
MONITOR_IFACE=ens33
MONITOR_TEMP_ENABLED=true
# Optional Linux millidegree sensor path; otherwise discover CPU sensors.
MONITOR_TEMP_PATH=
CPU_THRESHOLD=75
RAM_THRESHOLD=65
TEMP_THRESHOLD=65
# Recover at threshold minus this margin to prevent flapping.
RECOVERY_MARGIN=5

SSH_PORT=22
SSH_USER=
SSH_KEY_FILE=
# Prefer an SSH key or ssh-agent. Password is optional.
SSH_PASSWORD=
SSH_KNOWN_HOSTS=~/.ssh/known_hosts

# Configure at least one channel; both may be enabled simultaneously.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# For SNMP: MONITOR_PROTOCOL=snmp; install requirements-snmp.txt.
# Version 3 uses authPriv with SHA-1 authentication and AES-128 privacy.
SNMP_PORT=161
SNMP_VERSION=3
SNMP_USER=
SNMP_AUTH_KEY=
SNMP_PRIV_KEY=
# Only for explicitly selected SNMP_VERSION=2c on a trusted network.
SNMP_COMMUNITY=
# Device-specific OIDs; CPU/RAM OIDs must return percent in [0,100].
SNMP_CPU_OID=
SNMP_RAM_OID=
# Alternative to RAM percent: used and total must have identical units.
SNMP_RAM_USED_OID=
SNMP_RAM_TOTAL_OID=
SNMP_TEMP_OID=
# Multiply temperature by this factor to obtain degrees C.
SNMP_TEMP_SCALE=1
# ifOperStatus.<ifIndex>: 1.3.6.1.2.1.2.2.1.8.<ifIndex>
SNMP_IFACE_OID=
# Default is .monitor_state/state.sqlite3 next to monitor_ssh.py.
# MONITOR_STATE_FILE=/absolute/path/to/state.sqlite3
