# Linux VM -> Windows host via VMware NAT. Load with Bash.
MONITOR_PROTOCOL=ssh
MONITOR_OS=windows
MONITOR_HOST=192.168.73.1
MONITOR_INTERVAL=30
MONITOR_TIMEOUT=10
MONITOR_IFACE='Wi-Fi'
# Windows CPU temperature needs a supported sensor/WMI provider.
MONITOR_TEMP_ENABLED=false
CPU_THRESHOLD=75
RAM_THRESHOLD=65
TEMP_THRESHOLD=65
RECOVERY_MARGIN=5
SSH_PORT=22
# Verify with whoami / $env:USERNAME on Windows.
SSH_USER='DELL'
SSH_PASSWORD=''
SSH_KEY_FILE=''
SSH_KNOWN_HOSTS=~/.ssh/known_hosts
# At least one channel is required. Put fresh credentials in .env, not here.
TELEGRAM_TOKEN=''
TELEGRAM_CHAT_ID=''
SLACK_WEBHOOK_URL=''
