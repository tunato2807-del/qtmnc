# Windows VS Code -> GNS3 Cloud/Switch -> Linux management NIC.
MONITOR_PROTOCOL='ssh'
MONITOR_OS='linux'
MONITOR_HOST='192.168.10.129'
MONITOR_IFACE='gns3test'
MONITOR_INTERVAL='5'
MONITOR_TIMEOUT='3'
MONITOR_TEMP_ENABLED='true'
TEMP_SOURCE='auto'
CPU_THRESHOLD='75'
RAM_THRESHOLD='65'
TEMP_THRESHOLD='65'
RECOVERY_MARGIN='5'
MONITOR_STATE_FILE='.monitor_state/gns3.sqlite3'
SSH_PORT='22'
SSH_USER='tuanto'
SSH_PASSWORD=''
SSH_KEY_FILE=''
SSH_KNOWN_HOSTS='~/.ssh/known_hosts'
SNMP_PROFILE='linux-extend'
# Version 2c is for this isolated read-only GNS3 lab; v3 is also supported.
SNMP_VERSION='2c'
SNMP_PORT='161'
SNMP_COMMUNITY=''
SNMP_USER=''
SNMP_AUTH_KEY=''
SNMP_PRIV_KEY=''
TELEGRAM_TOKEN=''
TELEGRAM_CHAT_ID=''
SLACK_WEBHOOK_URL=''
