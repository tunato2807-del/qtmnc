# Windows runs Python; the Linux VM is the monitored device.
# Copy to .env or use setup_windows.cmd. Enter fresh credentials locally.
MONITOR_PROTOCOL='ssh'
MONITOR_OS='linux'
MONITOR_HOST='192.168.73.129'
MONITOR_INTERVAL='30'
MONITOR_TIMEOUT='10'
MONITOR_IFACE='ens33'
# A VM typically has no CPU temperature sensor. This explicitly skips it.
MONITOR_TEMP_ENABLED='false'
CPU_THRESHOLD='75'
RAM_THRESHOLD='65'
TEMP_THRESHOLD='65'
RECOVERY_MARGIN='5'
SSH_PORT='22'
SSH_USER='tuanto'
SSH_PASSWORD=''
SSH_KEY_FILE=''
SSH_KNOWN_HOSTS='~/.ssh/known_hosts'
TELEGRAM_TOKEN=''
TELEGRAM_CHAT_ID=''
SLACK_WEBHOOK_URL=''
